# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Supabase project settings → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# NOTE: the Azure Translator key and the LLM provider key are NOT set here.
# They live as Supabase secrets (server-side only) since they must never
# reach the browser. See supabase/functions/chat/index.ts and PWA_AND_BACKEND_SETUP.md.
